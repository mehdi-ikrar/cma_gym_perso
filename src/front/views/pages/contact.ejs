<!DOCTYPE html>
<html lang="fr">
    <%- include('../partials/head') %>
<body>
    <!-- Ajoutez ce script juste après la balise <body> -->

    <div class="page-container">
        <%- include('../partials/header') %>
        
        <div class="content-wrapper">
            <!-- Barre de navigation latérale -->
            <%- include('../partials/sidebar') %>

            <!-- Contenu principal à droite -->
            <div class="main-content">
                <main>
                    <div class="container">
                        <section class="activities-hero">
                            <div class="activities-hero-content">
                                <h2 class="activities-hero-title">Contactez-nous</h2>
                                <p class="activities-hero-desc">
                                    Découvrez nos informations de contact et notre localisation pour nous rendre visite.
                                </p>
                            </div>
                        </section>
                        
                        <div class="contact-container">
                            <div class="contact-card main-card">
                                <div class="contact-header">
                                    <i class="fas fa-building"></i>
                                    <h3>CMA Gym</h3>
                                </div>
                                <div class="contact-body">
                                        <div class="contact-info-row">
                                            <div class="contact-icon">
                                                <i class="fas fa-heart"></i>
                                            </div>
                                            <div class="contact-text">
                                                <h3>Adresse</h3>
                                                <p>126 Rue des Cités, 93300 Aubervilliers</p>
                                            </div>
                                        </div>
                                        
                                        <div class="contact-info-row">
                                            <div class="contact-icon">
                                                <i class="fas fa-phone-alt"></i>
                                            </div>
                                            <div class="contact-text">
                                                <h3>Téléphone</h3>
                                                <p><a href="tel:0148335261">01 48 33 52 61</a></p>
                                            </div>
                                        </div>
                                        
                                        <div class="contact-info-row">
                                            <div class="contact-icon">
                                                <i class="fas fa-clock"></i>
                                            </div>
                                            <div class="contact-text">
                                                <h3>Horaires</h3>
                                                <p>Lundi au vendredi de 9h à 20h</p>
                                            </div>
                                        </div>
                                        
                                        <iframe 
                                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5244.574672820018!2d2.3856792770194093!3d48.90991759707837!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47e66c3be2679be1%3A0xd3333d2872239926!2s126%20Rue%20des%20Cit%C3%A9s%2C%2093300%20Aubervilliers!5e0!3m2!1sfr!2sfr!4v1742012943664!5m2!1sfr!2sfr" 
                                        width="100%" 
                                        height="400" 
                                        style="border:0;" 
                                        allowfullscreen="" 
                                        loading="lazy">
                                    </iframe>
                                </div>
                            </div>
                            <div class="contact-text">
                                <h3>Notre page Facebook</h3>
                                <div class="facebook-column">
                                    <div class="facebook-widget">
                                        <iframe 
                                            src="https://www.facebook.com/plugins/page.php?href=https%3A//www.facebook.com/cmagym93/?locale=fr_FR&tabs=timeline&width=800&height=700&small_header=false&adapt_container_width=false&hide_cover=false&show_facepile=true"
                                            width="500" height="700" 
                                            style="border:none;overflow:hidden"
                                            scrolling="no" frameborder="0" 
                                            allowfullscreen="true"
                                            allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share">
                                        </iframe>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="partners-section">
                            <h3 class="partners-title">Nos Partenaires</h3>
                            <div class="partners-grid">
                                <div class="partner-card">
                                    <div class="partner-image">
                                        <img src="/image/politique_de_la_ville.jpg" alt="Politique de la ville">
                                    </div>
                                </div>
                                <div class="partner-card">
                                    <div class="partner-image">
                                        <img src="/image/logo_aubervilliers.jpg" alt="Ville d'Aubervilliers">
                                    </div>
                                </div>
                                <div class="partner-card">
                                    <div class="partner-image">
                                        <img src="/image/cohesion-territoire.jpg" alt="Cohésion des territoires">
                                    </div>
                                </div>
                                <div class="partner-card">
                                    <div class="partner-image">
                                        <img src="/image/cité_éducatives.jpg" alt="Cités éducatives">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
        
        <%- include('../partials/footer') %>
    </div>
</body>
</html>

